# Database (local dev — update with your PostgreSQL credentials)
DATABASE_URL=""
DIRECT_URL=""

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="dev-secret-change-in-production-abc123xyz"

# Google OAuth (fill when ready)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OpenAI
OPENAI_API_KEY=""

# Azure Speech
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION="centralindia"

# Razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# AWS S3
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="pte-platform"

# WhatsApp
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# App
NEXT_PUBLIC_APP_NAME="PTE Master"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Upstash Redis (For Rate Limiting)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# AI spend guards (need Redis above). Daily cap per user, resets at midnight IST (0 = off).
AI_DAILY_CAP_PER_USER=100
# Global monthly cap on AI scoring calls across all users (0 = off).
AI_MONTHLY_CAP=0

# Email SMTP (e.g. Gmail)
SMTP_EMAIL="your-email@gmail.com"
SMTP_PASSWORD="your-16-char-app-password"
