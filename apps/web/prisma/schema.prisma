generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  SUPER_ADMIN
  CENTRE_ADMIN
  TEACHER
  STUDENT
}

enum PlanType {
  FREE
  VIP_30
  VIP_90
  VIP_180
}

enum PlanStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum QuestionSection {
  SPEAKING
  WRITING
  READING
  LISTENING
}

enum QuestionType {
  // Speaking
  READ_ALOUD
  REPEAT_SENTENCE
  DESCRIBE_IMAGE
  RETELL_LECTURE
  ANSWER_SHORT_QUESTION
  RESPOND_TO_SITUATION
  SUMMARIZE_GROUP_DISCUSSION

  // Writing
  SUMMARIZE_WRITTEN_TEXT
  WRITE_ESSAY

  // Reading
  READING_MCQ_SINGLE
  READING_MCQ_MULTIPLE
  REORDER_PARAGRAPHS
  READING_FILL_BLANKS_DRAG
  READING_FILL_BLANKS_DROPDOWN

  // Listening
  SUMMARIZE_SPOKEN_TEXT
  LISTENING_MCQ_SINGLE
  LISTENING_MCQ_MULTIPLE
  LISTENING_FILL_BLANKS
  HIGHLIGHT_CORRECT_SUMMARY
  HIGHLIGHT_INCORRECT_WORDS
  SELECT_MISSING_WORD
  WRITE_FROM_DICTATION
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum TestStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum Language {
  EN
  HI
  PA
}

// ============================================================================
// CORE: USERS & CENTRES (Multi-Tenant)
// ============================================================================

model Centre {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique // used for subdomain: divinesuccess.pteapp.in
  logo        String?  // URL to logo image
  primaryColor String  @default("#4F46E5") // brand color
  address     String?
  city        String?
  state       String?
  phone       String?
  email       String?
  website     String?
  isActive    Boolean  @default(true)
  // Premium centre = all students get full access (all modules free)
  // Only super admin can set this
  isPremiumCentre Boolean @default(false)
  premiumUntil    DateTime? // optional expiry for premium status
  // Official content centre — questions added by this centre are
  // automatically marked public and visible to all users on the platform.
  // Use this for the "global question bank" centre.
  isOfficialContent Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  users          User[]
  questions      Question[]
  batches        Batch[]
  subscriptions  CentreSubscription[]
  announcements  Announcement[]
  invitations    CentreInvitation[]
  studentSeats   CentreStudentSeat[]

  @@index([slug])
  @@index([city, state])
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  phone         String?   @unique
  passwordHash  String?
  name          String
  avatar        String?
  role          UserRole  @default(STUDENT)
  language      Language  @default(EN)
  isActive      Boolean   @default(true)
  emailVerified DateTime?

  // Single active session — new logins invalidate old sessions on other devices
  activeSessionId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Multi-tenant
  centreId      String?
  centre        Centre?   @relation(fields: [centreId], references: [id])

  // Relations
  studentPlan      StudentPlan?
  attempts         Attempt[]
  mockTests        MockTest[]
  vocabProgress    VocabProgress[]
  oauthAccounts    OAuthAccount[]
  batchMemberships BatchMember[]
  moduleAccess     ModuleAccess[]
  centreSeats      CentreStudentSeat[]

  @@index([email])
  @@index([centreId])
  @@index([role])
}

// ============================================================================
// CENTRE STUDENT SEATS — per-student 90-day access granted by centre admin
// ============================================================================
model CentreStudentSeat {
  id        String   @id @default(cuid())
  centreId  String
  centre    Centre   @relation(fields: [centreId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate DateTime @default(now())
  endDate   DateTime // startDate + 90 days
  status    String   @default("ACTIVE") // ACTIVE, CANCELLED
  createdAt DateTime @default(now())

  @@unique([centreId, userId])
  @@index([centreId])
  @@index([userId])
}

// ============================================================================
// CENTRE INVITATIONS — admin invites students by email
// ============================================================================
model CentreInvitation {
  id        String   @id @default(cuid())
  centreId  String
  centre    Centre   @relation(fields: [centreId], references: [id], onDelete: Cascade)
  email     String
  status    String   @default("PENDING") // PENDING, ACCEPTED
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([email])
  @@index([centreId])
}

// ============================================================================
// PASSWORD RESET TOKENS
// ============================================================================
model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}

// ============================================================================
// MODULE ACCESS — per-section purchases (Speaking, Writing, Reading, Listening)
// ============================================================================
model ModuleAccess {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // null section = all modules (full access plan)
  section   QuestionSection?

  startedAt DateTime @default(now())
  expiresAt DateTime // 90 days from purchase
  isActive  Boolean  @default(true)

  // Link to payment that granted this access
  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, section])
  @@index([userId])
  @@index([expiresAt])
}

model OAuthAccount {
  id                String  @id @default(cuid())
  provider          String  // "google", "facebook"
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         Int?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Batch {
  id        String   @id @default(cuid())
  name      String   // "Morning Batch", "Weekend Batch"
  centreId  String
  centre    Centre   @relation(fields: [centreId], references: [id])
  createdAt DateTime @default(now())

  members BatchMember[]

  @@index([centreId])
}

model BatchMember {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([userId, batchId])
}

// ============================================================================
// SUBSCRIPTIONS & PAYMENTS
// ============================================================================

// Student subscription (B2C)
model StudentPlan {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  planType  PlanType   @default(FREE)
  status    PlanStatus @default(ACTIVE)
  startDate DateTime   @default(now())
  endDate   DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  payments Payment[]
}

// Centre subscription (B2B)
model CentreSubscription {
  id              String     @id @default(cuid())
  centreId        String
  centre          Centre     @relation(fields: [centreId], references: [id])
  planName        String     // "Starter", "Growth", "Pro"
  maxStudents     Int        @default(50)
  monthlyPrice    Int        // in paise (INR)
  status          PlanStatus @default(ACTIVE)
  startDate       DateTime   @default(now())
  endDate         DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  payments Payment[]

  @@index([centreId])
}

model Payment {
  id                  String        @id @default(cuid())
  amount              Int           // in paise
  currency            String        @default("INR")
  status              PaymentStatus @default(PENDING)
  razorpayOrderId     String?       @unique
  razorpayPaymentId   String?       @unique
  razorpaySignature   String?
  method              String?       // "upi", "card", "netbanking"
  createdAt           DateTime      @default(now())

  // Polymorphic: either student plan or centre subscription
  studentPlanId       String?
  studentPlan         StudentPlan?       @relation(fields: [studentPlanId], references: [id])
  centreSubscriptionId String?
  centreSubscription  CentreSubscription? @relation(fields: [centreSubscriptionId], references: [id])
  moduleAccesses       ModuleAccess[]

  // What was purchased (for module purchases)
  planType             String?       // "MODULE_SPEAKING", "MODULE_WRITING", etc., or "ALL_MODULES"

  @@index([razorpayOrderId])
}

model Coupon {
  id            String    @id @default(cuid())
  code          String    @unique
  discountPercent Int     // 10 = 10% off
  maxUses       Int       @default(100)
  usedCount     Int       @default(0)
  validFrom     DateTime  @default(now())
  validUntil    DateTime
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
}

// ============================================================================
// QUESTION BANK
// ============================================================================

model Question {
  id            String          @id @default(cuid())
  section       QuestionSection
  type          QuestionType
  difficulty    Difficulty      @default(MEDIUM)
  title         String          // short identifier
  isPrediction  Boolean         @default(false) // weekly prediction
  isActive      Boolean         @default(true)
  order         Int             @default(0) // for ordering in mock tests
  marks         Int             @default(1) // total marks for this question
  isPublic      Boolean         @default(false) // free for all users (set by super admin)
  tags          String[]        // ["transport", "science", "graph"]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Who created: null = global (super admin), centreId = centre-specific
  centreId      String?
  centre        Centre?         @relation(fields: [centreId], references: [id])

  // Content stored as JSON — flexible for all 20+ question types
  // Examples:
  //   READ_ALOUD: { text: "..." }
  //   DESCRIBE_IMAGE: { imageUrl: "..." }
  //   MCQ: { passage: "...", options: [...], correctAnswer: 0 }
  //   REORDER: { paragraphs: [...], correctOrder: [2,0,3,1] }
  //   FILL_BLANKS: { passage: "...", blanks: [...], options: [...] }
  //   WRITE_ESSAY: { prompt: "...", minWords: 200, maxWords: 300 }
  content       Json

  // Optional: model answer / explanation
  explanation   String?
  modelAnswer   String?
  audioUrl      String?  // for listening/speaking questions
  imageUrl      String?  // for describe image

  // Relations
  attempts      Attempt[]
  mockTestQuestions MockTestQuestion[]

  @@index([section, type])
  @@index([centreId])
  @@index([isPrediction])
  @@index([difficulty])
}

// ============================================================================
// PRACTICE ATTEMPTS
// ============================================================================

model Attempt {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId  String
  question    Question @relation(fields: [questionId], references: [id])

  // Student's response
  responseText  String?  // written/typed response
  responseAudio String?  // S3 URL for audio recording

  // AI Scores (stored as JSON for flexibility)
  // Speaking: { pronunciation: 85, fluency: 78, content: 90, overall: 84 }
  // Writing: { grammar: 80, spelling: 95, content: 75, structure: 85, overall: 84 }
  // Reading/Listening: { correct: true, score: 1 }
  scores        Json?

  overallScore  Float?    // 0-90 PTE scale
  timeTaken     Int?      // seconds
  feedback      String?   // AI-generated improvement tips
  createdAt     DateTime  @default(now())

  // Part of a mock test?
  mockTestId    String?
  mockTest      MockTest? @relation(fields: [mockTestId], references: [id])

  @@index([userId])
  @@index([questionId])
  @@index([userId, questionId])
  @@index([userId, createdAt]) // for daily scoring count + recent activity
  @@index([mockTestId])
  @@index([createdAt])
}

// ============================================================================
// MOCK TESTS
// ============================================================================

model MockTest {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String     @default("Full Mock Test")
  status      TestStatus @default(IN_PROGRESS)

  // Timing
  startedAt   DateTime   @default(now())
  completedAt DateTime?
  totalTime   Int?       // seconds taken

  // Scores
  speakingScore  Float?
  writingScore   Float?
  readingScore   Float?
  listeningScore Float?
  overallScore   Float?

  // Current position in test
  currentSection  QuestionSection @default(SPEAKING)
  currentIndex    Int             @default(0)

  createdAt   DateTime @default(now())

  // Relations
  questions   MockTestQuestion[]
  attempts    Attempt[]

  @@index([userId])
  @@index([status])
}

model MockTestQuestion {
  id         String   @id @default(cuid())
  mockTestId String
  mockTest   MockTest @relation(fields: [mockTestId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
  order      Int      // position in the test

  @@unique([mockTestId, questionId])
  @@index([mockTestId])
}

// ============================================================================
// STUDY GUIDES & VOCABULARY
// ============================================================================

model StudyGuide {
  id           String          @id @default(cuid())
  title        String
  slug         String          @unique
  section      QuestionSection
  questionType QuestionType?
  content      String          // markdown content
  language     Language        @default(EN)
  order        Int             @default(0)
  isPublished  Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([section])
  @@index([questionType])
}

model Template {
  id           String       @id @default(cuid())
  title        String
  questionType QuestionType
  content      String       // the actual template text
  language     Language     @default(EN)
  isPremium    Boolean      @default(false) // VIP only
  createdAt    DateTime     @default(now())

  @@index([questionType])
}

model Vocabulary {
  id          String   @id @default(cuid())
  word        String   @unique
  meaning     String
  meaningHi   String?  // Hindi meaning
  meaningPa   String?  // Punjabi meaning
  example     String   // usage in sentence
  category    String?  // "academic", "everyday", "topic-specific"
  difficulty  Difficulty @default(MEDIUM)
  dayNumber   Int?     // for "word of the day" feature
  createdAt   DateTime @default(now())

  progress    VocabProgress[]

  @@index([dayNumber])
  @@index([category])
}

model VocabProgress {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabId   String
  vocab     Vocabulary @relation(fields: [vocabId], references: [id])
  mastered  Boolean  @default(false)
  reviewCount Int    @default(0)
  lastReviewed DateTime?

  @@unique([userId, vocabId])
}

// ============================================================================
// ANNOUNCEMENTS & NOTIFICATIONS
// ============================================================================

model Announcement {
  id        String   @id @default(cuid())
  centreId  String?
  centre    Centre?  @relation(fields: [centreId], references: [id])
  title     String
  message   String
  isGlobal  Boolean  @default(false) // show to all centres
  createdAt DateTime @default(now())

  @@index([centreId])
  @@index([isGlobal])
}
