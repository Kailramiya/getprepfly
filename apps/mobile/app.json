{
  "expo": {
    "name": "PTE Master",
    "slug": "pte-master",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ptemaster",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#4F46E5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ptemaster.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "PTE Master needs microphone access for speaking practice"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4F46E5"
      },
      "package": "com.ptemaster.app",
      "permissions": ["RECORD_AUDIO"]
    },
    "plugins": [
      "expo-router",
      [
        "expo-av",
        { "microphonePermission": "PTE Master needs microphone for speaking practice" }
      ]
    ]
  }
}
