# ============================================================================
# PTE Platform — Environment Variables
# Copy this to .env and fill in your values
# ============================================================================

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/pte_platform"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-change-this-in-production"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OpenAI (Speaking + Writing AI Scoring)
OPENAI_API_KEY=""

# Upstash Redis (Rate limiting) — required in production
# Create a database at https://console.upstash.com → REST API section
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Sentry (Error monitoring) — optional but strongly recommended in production
# Project DSN from https://sentry.io → Project Settings → Client Keys (DSN)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# Azure Speech (Pronunciation Assessment)
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION="centralindia"

# Razorpay (Payments)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# AWS S3 (Audio/Image Storage)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="pte-platform"

# WhatsApp Business API
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Email — Resend (preferred for production deliverability)
# Create an API key at https://resend.com and verify your sending domain.
RESEND_API_KEY=""
# Sender shown on outgoing mail; must be on a domain verified in Resend.
EMAIL_FROM="Prepfly <noreply@yourdomain.com>"

# Email Notifications (Gmail SMTP) — legacy fallback for local/dev only
SMTP_EMAIL=""
SMTP_PASSWORD=""
ADMIN_NOTIFICATION_EMAIL="amankundu369@gmail.com"

# App
NEXT_PUBLIC_APP_NAME="Prepfly"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database seeding (prisma/seed.ts)
# The seed refuses to run in production unless SEED_ALLOW_PRODUCTION=true, and
# requires an explicit super-admin password (no insecure default in prod).
SEED_SUPER_ADMIN_EMAIL=""
SEED_SUPER_ADMIN_NAME=""
SEED_SUPER_ADMIN_PASSWORD=""
# SEED_ALLOW_PRODUCTION="true"   # uncomment ONLY for an intentional prod seed
