# ============================================================================
# PTE Platform — Environment Variables
# Copy this to .env and fill in your values
# ============================================================================

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/pte_platform"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-change-this-in-production"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OpenAI (Speaking + Writing AI Scoring)
OPENAI_API_KEY=""

# Azure Speech (Pronunciation Assessment)
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION="centralindia"

# Razorpay (Payments)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# AWS S3 (Audio/Image Storage)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="pte-platform"

# WhatsApp Business API
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# App
NEXT_PUBLIC_APP_NAME="PTE Master"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
